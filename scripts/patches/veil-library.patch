+use aes_gcm::aead::{Aead, KeyInit, Payload};
 use aes_gcm::{Aes256Gcm, Nonce};
 use hkdf::Hkdf;
 use hmac::{Hmac, Mac};
@@ -15,6 +15,40 @@ const GCM_TAG_LEN: usize = 16;
 
 type HmacSha256 = Hmac<Sha256>;
 
+/// OAuth 恢复材料使用独立 HKDF 域，并将调用方的 flow/owner 绑定为 AEAD 附加数据。
+#[derive(Zeroize, ZeroizeOnDrop)]
+pub struct CheckpointCipher([u8; 32]);
+
+#[derive(Debug)]
+pub struct CheckpointError;
+
+impl CheckpointCipher {
+    pub fn new(master_key: &[u8; 32]) -> Self {
+        let mut key = [0u8; 32];
+        Hkdf::<Sha256>::new(Some(b"cprs-oauth-checkpoint-v1"), master_key)
+            .expand(b"aes-256-gcm", &mut key).expect("32-byte HKDF output");
+        Self(key)
+    }
+
+    pub fn seal(&self, binding: &[u8], plaintext: &[u8]) -> Result<Vec<u8>, CheckpointError> {
+        let mut nonce = [0u8; NONCE_LEN];
+        OsRng.try_fill_bytes(&mut nonce).map_err(|_| CheckpointError)?;
+        let cipher = Aes256Gcm::new_from_slice(&self.0).map_err(|_| CheckpointError)?;
+        let ciphertext = cipher.encrypt(Nonce::from_slice(&nonce), Payload { msg: plaintext, aad: binding })
+            .map_err(|_| CheckpointError)?;
+        let mut output = nonce.to_vec();
+        output.extend(ciphertext);
+        Ok(output)
+    }
+
+    pub fn open(&self, binding: &[u8], ciphertext: &[u8]) -> Result<Vec<u8>, CheckpointError> {
+        if ciphertext.len() < NONCE_LEN + GCM_TAG_LEN { return Err(CheckpointError); }
+        let (nonce, ciphertext) = ciphertext.split_at(NONCE_LEN);
+        let cipher = Aes256Gcm::new_from_slice(&self.0).map_err(|_| CheckpointError)?;
+        cipher.decrypt(Nonce::from_slice(nonce), Payload { msg: ciphertext, aad: binding }).map_err(|_| CheckpointError)
+    }
+}
