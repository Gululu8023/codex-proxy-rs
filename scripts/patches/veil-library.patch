+//! Anthropic 原生 JSON 的协议边界；文本算法与映射存储继续复用引擎。
+
+use serde_json::Value;
+use crate::{creator::Creator, mapping::MappingStore, rules::RuleSet,
+    walk::{desensitize_literal_safe_string, restore_string, WalkError}};
+
+pub fn desensitize_json(value: &Value, rules: &RuleSet, store: &(impl MappingStore + ?Sized), creator: &Creator) -> Result<Value, WalkError> {
+    transform_text(value, &mut |text| desensitize_literal_safe_string(text, rules, store, creator))
+}
+/// 在协议判定之后处理普通文本；缓存宿主不能绕过签名、思考块和身份字段的边界。
+pub fn transform_text(value: &Value, transform: &mut impl FnMut(&str) -> Result<String, WalkError>) -> Result<Value, WalkError> {
+    visit(value, Location::Root, transform)
+}
+pub fn restore_json(value: &Value, store: &(impl MappingStore + ?Sized), creator: &Creator) -> Result<Value, WalkError> {
+    visit(value, Location::Root, &mut |text| restore_string(text, store, creator, true))
+}
+
+#[derive(Clone, Copy)]
+enum Location {
+    Root, Messages, Message, Content, Block, System, SystemBlock, Billing,
+    Tools, Tool, Addition, AddedTool, Schema, SchemaProperties, Source,
+    Metadata, Identity, Thread, Diagnostics, Output, Format, Text, Opaque,
+}
+fn child(location: Location, key: &str, value: &Value) -> Location {
+    use Location::*;
+    match (location, key) {
+        (Root, "messages") => Messages,
+        (Root, "system") => System,
+        (Root, "content") | (Message, "content") | (Block | SystemBlock, "content") => Content,
+        (Root, "tools") => Tools,
+        (Root, "metadata") => Metadata,
+        (Root, "thread") => Thread,
+        (Root, "diagnostics") => Diagnostics,
+        (Root, "output_config") => Output,
+        (Root, "id" | "type" | "model" | "usage" | "stop_reason" | "stop_sequence" | "stop_sequences"
+            | "thinking" | "context_management" | "input_transformations" | "tool_choice"
+            | "container" | "service_tier") => Opaque,
+        (Message, "role") => Opaque,
+        (Block | SystemBlock | Addition, "type" | "id" | "name" | "tool_use_id" | "signature" | "block_binding" | "cache_control") => Opaque,
+        (Block | SystemBlock, "source") => Source,
+        (SystemBlock, "text") => Billing,
+        (Addition, "tool") => AddedTool,
+        (AddedTool, "name") => Opaque,
+        (AddedTool, "definition") => Tool,
+        (Tool, "type" | "name" | "cache_control" | "strict" | "defer_loading") => Opaque,
+        (Tool, "input_schema") | (Format, "schema") => Schema,
+        (Schema, "properties" | "patternProperties" | "$defs" | "definitions" | "dependentSchemas") => SchemaProperties,
+        (SchemaProperties, _) => Schema,
+        (Schema, "items" | "prefixItems" | "allOf" | "anyOf" | "oneOf" | "not" | "if" | "then" | "else"
+            | "contains" | "additionalProperties" | "unevaluatedProperties" | "propertyNames") => Schema,
+        (Schema, "description" | "title" | "default" | "examples" | "enum" | "const") => Text,
+        (Schema, _) => Opaque,
+        (Source, "type" | "media_type") => Opaque,
+        (Metadata, "user_id") => Identity,
+        (Identity, "device_id") if value.as_str().is_some_and(|s| s.len() == 64 && s.bytes().all(|b| b.is_ascii_hexdigit())) => Opaque,
+        (Identity, "account_uuid" | "session_id") if value.as_str().is_some_and(uuid) => Opaque,
+        (Thread, "type") if matches!(value.as_str(), Some("create" | "continue")) => Opaque,
+        (Thread | Diagnostics, "previous_message_id") if value.as_str().is_some_and(message_id) => Opaque,
+        (Output, "format") => Format,
+        (Format, _) | (Output, "effort") => Opaque,
+        _ => Text,
+    }
+}
+fn uuid(s: &str) -> bool {
+    s.len() == 36 && s.bytes().enumerate().all(|(i, b)| if matches!(i, 8 | 13 | 18 | 23) { b == b'-' } else { b.is_ascii_hexdigit() })
+}
+fn message_id(s: &str) -> bool {
+    s.strip_prefix("msg_").is_some_and(|s| !s.is_empty() && s.len() <= 252 && s.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-'))
+}
+fn billing(s: &str) -> bool {
+    let Some(tail) = s.strip_prefix("x-anthropic-billing-header: ").and_then(|s| s.strip_suffix(';')) else { return false; };
+    let mut keys = Vec::new();
+    for part in tail.split(';') {
+        let Some((key, value)) = part.trim().split_once('=') else { return false; };
+        if keys.contains(&key) || value.is_empty() || value.len() > 256 { return false; }
+        let valid = match key {
+            "cc_version" => value.rsplit_once('.').is_some_and(|(version, hash)| {
+                let parts: Vec<_> = version.split('.').collect();
+                parts.len() == 3 && parts.iter().all(|p| !p.is_empty() && p.bytes().all(|b| b.is_ascii_digit()))
+                    && hash.len() == 3 && hash.bytes().all(|b| b.is_ascii_hexdigit())
+            }),
+            "cc_entrypoint" => matches!(value, "cli" | "cli-bg" | "vscode" | "native"),
+            "cch" => value.len() == 5 && value.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+            "cc_is_subagent" => value == "true",
+            "cc_workload" | "cc_prev_req" | "cc_prompt_id" | "cc_turn_origin" => value.bytes().all(|b| b.is_ascii_alphanumeric() || b"-_.".contains(&b)),
+            _ => false,
+        };
+        if !valid { return false; }
+        keys.push(key);
+    }
+    keys.contains(&"cc_version") && keys.contains(&"cc_entrypoint")
+}
+
+fn visit(value: &Value, mut location: Location, transform: &mut impl FnMut(&str) -> Result<String, WalkError>) -> Result<Value, WalkError> {
+    use Location::*;
+    if matches!(location, Opaque) { return Ok(value.clone()); }
+    if matches!(location, Content) && value.is_object() { location = Block; }
+    // Only protocol block positions grant opaque treatment. Tool argument names never do.
+    if matches!(location, Block | SystemBlock) {
+        match value.get("type").and_then(Value::as_str) {
+            Some("thinking" | "redacted_thinking") => return Ok(value.clone()),
+            Some("tool_addition") => location = Addition,
+            _ => {},
+        }
+    }
+    if matches!(location, Source) && value.get("type").and_then(Value::as_str) == Some("base64") { return Ok(value.clone()); }
+    match value {
+        Value::String(text) if matches!(location, Identity) => {
+            // Preserve only validated identifiers inside normalized user_id; textual extras remain private.
+            if let Ok(Value::Object(object)) = serde_json::from_str::<Value>(text) {
+                let transformed = visit(&Value::Object(object), Identity, transform)?;
+                Ok(Value::String(transformed.to_string()))
+            } else { Ok(Value::String(transform(text)?)) }
+        }
+        Value::String(text) if matches!(location, Billing) && billing(text) => Ok(value.clone()),
+        Value::String(text) => Ok(Value::String(transform(text)?)),
+        Value::Array(items) => items.iter().enumerate().map(|(index, item)| {
+            let item_location = match location {
+                Messages => Message, Content => Block, System if index == 0 => SystemBlock,
+                System => Block, Tools => Tool, other => other,
+            };
+            visit(item, item_location, transform)
+        }).collect::<Result<Vec<_>, _>>().map(Value::Array),
+        Value::Object(object) => {
+            let mut output = serde_json::Map::with_capacity(object.len());
+            for (key, value) in object { output.insert(key.clone(), visit(value, child(location, key, value), transform)?); }
+            Ok(Value::Object(output))
+        }
+        other => Ok(other.clone()),
+    }
+}
diff --git a/crates/veil/src/proxy/anthropic_sse.rs b/crates/veil/src/proxy/anthropic_sse.rs
new file mode 100644
index 0000000..11c579f
--- /dev/null
+++ b/crates/veil/src/proxy/anthropic_sse.rs
@@ -0,0 +1,186 @@
+use std::collections::HashMap;
+
+use serde_json::{json, Value};
+use veil_engine::{
+    creator::Creator,
+    mapping::MappingStore,
+    sliding::RestoreWindow,
+    walk::{restore_json, restore_json_strict, WalkError},
+};
+
+const MAX_PENDING_BYTES: usize = 32 * 1024 * 1024;
+
+pub(super) enum BlockOutput {
+    Current,
+    Buffered,
+    Before(Value),
+}
+
+enum Block<'a, S: MappingStore + ?Sized> {
+    Text(RestoreWindow<'a, S>),
+    Tool(String),
+    Opaque,
+}
+
+pub(super) struct AnthropicBlocks<'a, S: MappingStore + ?Sized> {
+    store: &'a S,
+    creator: Creator,
+    strict: bool,
+    blocks: HashMap<u64, Block<'a, S>>,
+    pending_bytes: usize,
+}
+
+impl<'a, S: MappingStore + ?Sized> AnthropicBlocks<'a, S> {
+    pub(super) fn new(store: &'a S, creator: Creator, strict: bool) -> Self {
+        Self { store, creator, strict, blocks: HashMap::new(), pending_bytes: 0 }
+    }
+
+    pub(super) fn finish(&self) -> Result<(), WalkError> {
+        if self.blocks.is_empty() { Ok(()) } else { Err(WalkError::InvalidStream) }
+    }
+
+    fn restore(&self, value: &Value) -> Result<Value, WalkError> {
+        if self.strict {
+            restore_json_strict(value, self.store, &self.creator)
+        } else {
+            restore_json(value, self.store, &self.creator)
+        }
+    }
+
+    fn restore_fields(&self, value: &mut Value, fields: &[&str]) -> Result<(), WalkError> {
+        for field in fields {
+            if let Some(text) = value.get_mut(*field).filter(|value| value.is_string()) {
+                *text = self.restore(text)?;
+            }
+        }
+        Ok(())
+    }
+
+    fn restore_citation(&self, citation: &mut Value) -> Result<(), WalkError> {
+        if matches!(citation["type"].as_str(), Some("char_location" | "page_location" | "content_block_location"
+            | "web_search_result_location" | "search_result_location")) {
+            // encrypted_index、来源索引和签名属于协议数据，不能作为可逆文本遍历。
+            self.restore_fields(citation, &["cited_text", "document_title", "title", "url"])?;
+        }
+        Ok(())
+    }
+
+    fn restore_result(&self, result: &mut Value) -> Result<(), WalkError> {
+        match result["type"].as_str() {
+            Some("web_search_result") => self.restore_fields(result, &["title", "url"]),
+            Some("web_fetch_result") => {
+                self.restore_fields(result, &["url"])?;
+                let document = &mut result["content"];
+                if document["type"] == "document" {
+                    self.restore_fields(document, &["title"])?;
+                    if document["source"]["type"] == "text" {
+                        self.restore_fields(&mut document["source"], &["data"])?;
+                    }
+                }
+                Ok(())
+            }
+            _ => Ok(()),
+        }
+    }
+
+    /// 只改允许恢复的内容；签名、thinking、用量和未知事件不进入通用字符串遍历。
+    /// 返回的补充 delta 必须在当前 block_stop 前交付。
+    pub(super) fn event(&mut self, value: &mut Value) -> Result<BlockOutput, WalkError> {
+        match value["type"].as_str() {
+            Some("content_block_start") => {
+                let index = value["index"].as_u64().ok_or(WalkError::InvalidStream)?;
+                if self.blocks.contains_key(&index) {
+                    return Err(WalkError::InvalidStream);
+                }
+                if self.blocks.len() >= 1024 { return Err(WalkError::BufferLimit); }
+                let content = &mut value["content_block"];
+                let block = match content["type"].as_str() {
+                    Some("text") => {
+                        let mut window = if self.strict {
+                            RestoreWindow::new_strict(self.store, self.creator)
+                        } else {
+                            RestoreWindow::new(self.store, self.creator)
+                        };
+                        let text = content["text"].as_str().ok_or(WalkError::InvalidStream)?;
+                        content["text"] = Value::String(window.push(text)?);
+                        if let Some(citations) = content.get_mut("citations").and_then(Value::as_array_mut) {
+                            for citation in citations { self.restore_citation(citation)?; }
+                        }
+                        Block::Text(window)
+                    }
+                    Some("tool_use" | "server_tool_use") => {
+                        if let Some(input) = content.get_mut("input") {
+                            *input = self.restore(input)?;
+                        }
+                        Block::Tool(String::new())
+                    }
+                    Some("web_search_tool_result" | "web_fetch_tool_result") => {
+                        if let Some(result) = content.get_mut("content") {
+                            if let Some(results) = result.as_array_mut() {
+                                for result in results { self.restore_result(result)?; }
+                            } else { self.restore_result(result)?; }
+                        }
+                        Block::Opaque
+                    }
+                    _ => Block::Opaque,
+                };
+                self.blocks.insert(index, block);
+            }
+            Some("content_block_delta") => {
+                let index = value["index"].as_u64().ok_or(WalkError::InvalidStream)?;
+                if value["delta"]["type"] == "citations_delta" && matches!(self.blocks.get(&index), Some(Block::Text(_))) {
+                    if let Some(citation) = value["delta"].get_mut("citation") { self.restore_citation(citation)?; }
+                }
+                let block = self.blocks.get_mut(&index).ok_or(WalkError::InvalidStream)?;
+                let delta = &mut value["delta"];
+                match (block, delta["type"].as_str()) {
+                    (Block::Text(window), Some("text_delta")) => {
+                        let text = delta["text"].as_str().ok_or(WalkError::InvalidStream)?;
+                        delta["text"] = Value::String(window.push(text)?);
+                    }
+                    (Block::Tool(buffer), Some("input_json_delta")) => {
+                        let fragment = delta["partial_json"].as_str().ok_or(WalkError::InvalidStream)?;
+                        if fragment.len() > MAX_PENDING_BYTES.saturating_sub(self.pending_bytes) {
+                            return Err(WalkError::BufferLimit);
+                        }
+                        self.pending_bytes += fragment.len();
+                        buffer.push_str(fragment);
+                        // 工具参数是嵌套 JSON，等待整块解析后恢复，不能将原文直接插进 JSON 片段。
+                        // 不发送空 JSON delta，客户端可能立即解析每个工具参数事件。
+                        return Ok(BlockOutput::Buffered);
+                    }
+                    _ => {}
+                }
+            }
+            Some("content_block_stop") => {
+                let index = value["index"].as_u64().ok_or(WalkError::InvalidStream)?;
+                let block = self.blocks.remove(&index).ok_or(WalkError::InvalidStream)?;
+                let delta = match block {
+                    Block::Text(mut window) => {
+                        let tail = window.flush()?;
+                        if tail.is_empty() { return Ok(BlockOutput::Current); }
+                        json!({"type":"text_delta","text":tail})
+                    }
+                    Block::Tool(buffer) => {
+                        self.pending_bytes -= buffer.len();
+                        if buffer.is_empty() { return Ok(BlockOutput::Current); }
+                        let input: Value = serde_json::from_str(&buffer).map_err(|_| WalkError::InvalidStream)?;
+                        if !input.is_object() { return Err(WalkError::InvalidStream); }
+                        let restored = self.restore(&input)?;
+                        json!({"type":"input_json_delta","partial_json":restored.to_string()})
+                    }
+                    Block::Opaque => return Ok(BlockOutput::Current),
+                };
+                return Ok(BlockOutput::Before(json!({"type":"content_block_delta","index":index,"delta":delta})));
+            }
+            Some("message_stop") => self.finish()?,
+            Some("error") => {
+                if let Some(message) = value.pointer_mut("/error/message") {
+                    *message = self.restore(message)?;
+                }
+            }
+            _ => {}
+        }
+        Ok(BlockOutput::Current)
+    }
+}
