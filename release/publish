#!/usr/bin/env bash
set -euo pipefail

APP_NAME="codex-proxy-rs"
VERSION_FILE="release/version.yaml"

usage() {
  cat <<USAGE
Usage:
  release/publish --check <version>
  release/publish <version>

Commit release/version.yaml and release/notes.md with the intended changes,
then push main before publishing. The version must match both files.
--check is read-only. Publishing creates and pushes an annotated tag;
the tag push starts release.yml. This command does not commit or dispatch again.
USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

check_only=false
if [[ "${1:-}" == "--check" ]]; then
  check_only=true
  # 只读检查也禁止 Git 的可选索引刷新。
  export GIT_OPTIONAL_LOCKS=0
  shift
fi

[[ "$#" -eq 1 ]] || {
  usage >&2
  exit 2
}

require_command git
require_command gh
require_command ruby
gh auth status >/dev/null 2>&1 || die "gh authentication is required"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repository"
cd "$repo_root"
version="$(ruby .github/scripts/release-metadata.rb validate "$1")"
tag="v$version"
current_version="$(ruby -ryaml -e 'puts YAML.load_file(ARGV.fetch(0)).fetch("version")' "$VERSION_FILE")"
[[ "$version" == "$current_version" ]] || die "$VERSION_FILE must already contain $version"
ruby .github/scripts/toolchains.rb >/dev/null
ruby -r './.github/scripts/release-metadata' -e 'ReleaseMetadata.platforms'

branch="$(git symbolic-ref --quiet --short HEAD)" || die "publishing from detached HEAD is not supported"
[[ "$branch" == main ]] || die "releases must be published from main"
remote="$(git config --get branch.main.remote)" || die "main has no upstream"
merge_ref="$(git config --get branch.main.merge)" || die "main has no upstream ref"
[[ "$merge_ref" == refs/heads/main && "$remote" != . ]] || die "main must track a remote main branch"
remote_url="$(git remote get-url "$remote")"
repository="$(gh repo view "$remote_url" --json nameWithOwner --jq '.nameWithOwner')" ||
  die "failed to resolve GitHub repository"

# 未跟踪文件不属于发行提交；已跟踪改动必须先提交。
git diff --quiet --ignore-submodules -- && git diff --cached --quiet --ignore-submodules -- ||
  die "commit tracked changes before publishing"
if git show-ref --verify --quiet "refs/tags/$tag"; then
  die "local tag already exists: $tag; inspect the original run instead of replacing it"
fi

local_head="$(git rev-parse HEAD)"
remote_refs="$(git ls-remote "$remote" refs/heads/main "refs/tags/$tag" "refs/tags/$tag^{}")" ||
  die "failed to read remote refs"
remote_head="$(awk '$2 == "refs/heads/main" { print $1 }' <<< "$remote_refs")"
[[ "$local_head" == "$remote_head" ]] || die "local main must equal remote main; commit and synchronize first"
if awk -v ref="refs/tags/$tag" '$2 == ref { found = 1 } END { exit !found }' <<< "$remote_refs"; then
  die "remote tag already exists: $tag; retry release.yml for that tag"
fi
GITHUB_REPOSITORY="$repository" ruby .github/scripts/published-channels.rb check "$version"

if [[ "$check_only" == true ]]; then
  echo "Preflight passed: $APP_NAME $version at $local_head -> $repository"
  echo "No files, Git refs, or remote state changed. Release CI still validates the exact tag commit."
  exit 0
fi

git tag -a "$tag" -m "$tag"
git push "$remote" "refs/tags/$tag"

# 用户凭据推送 tag 已触发工作流；额外 dispatch 会造成同版本重复构建。
cat <<DONE
Pushed release tag for $APP_NAME $version
Commit: $local_head
Tag:    $tag
Check the Release run: https://github.com/$repository/actions/workflows/release.yml
DONE
